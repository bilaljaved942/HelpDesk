# All optional: the defaults work for a local run.

# Database (docker-compose.yml starts PostgreSQL + pgvector on 5434)
HELPDESK_DATABASE_URL=postgresql+psycopg://helpdesk:helpdesk@127.0.0.1:5434/helpdesk

# Local LLM through Ollama
HELPDESK_OLLAMA_URL=http://127.0.0.1:11434
HELPDESK_LLM_MODEL=qwen3:8b

# HubSpot private-app token (scopes: tickets). Empty = tickets stay in our DB only.
HELPDESK_HUBSPOT_TOKEN=

# Dashboard logins: set a long random secret in production; cookie_secure=true behind HTTPS
HELPDESK_JWT_SECRET=
HELPDESK_COOKIE_SECURE=false

# Website -> API (used by web/proxy.ts)
HELPDESK_API_URL=http://127.0.0.1:8100
